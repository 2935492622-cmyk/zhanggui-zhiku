# ============================================================
# 掌柜智库 · 环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后填真实值（.env 已被 .gitignore 忽略，不会提交进仓库）
#
# ⚠️ 重要：不要写行内注释！
#   python-dotenv 不会剥离未加引号的 # 后面的内容。
#   写成 LOG_FILE_LEVEL=INFO   # 控制台级别
#   读到的值是 "INFO   # 控制台级别"，喂给 loguru 会报「级别不存在」。
#   注释请单独占一行，就像这个文件这样。
# ============================================================

# ---------------- 运行环境 ----------------
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------------- 大模型（阿里云百炼，OpenAI 兼容模式）----------------
# 获取地址：https://bailian.console.aliyun.com → API-KEY 管理
# 没填（或还是下面的占位值）时 settings.has_llm_key 返回 False，
# 各节点会走降级路径，整条链路依然能跑通。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1
LLM_MODEL=qwen-flash
VLM_MODEL=qwen-vl-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ---------------- Embedding（本地 BGE-M3，不走云端）----------------
# 本项目唯一留在本地的模型：百炼的 embedding 只有稠密向量，没有稀疏，
# 而「稠密+稀疏混合」是核心卖点，所以 embedding 必须本地跑。
# BGE_M3_PATH 留 BAAI/bge-m3 会自动下载（约 2GB）；
# 国内下载慢就先设 export HF_ENDPOINT=https://hf-mirror.com
# 或者下到本地目录后，把这里改成那个目录的绝对路径。
BGE_M3_PATH=BAAI/bge-m3
# GPU 环境没配好时先改成 cpu，链路一样能通，只是慢
EMBEDDING_DEVICE=cuda
EMBEDDING_FP16=true
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LEN=8192

# ---------------- 重排序 ----------------
RERANK_MODEL=qwen3-rerank
RERANK_TOP_N=5
# 断崖检测：分数突然掉一大截时，后面的结果不再送给大模型
RERANK_CLIP_ABS=0.5
RERANK_CLIP_REL=0.25
RERANK_MIN_KEEP=3
RERANK_MAX_KEEP=10

# ---------------- 向量库 Milvus ----------------
# M0-M2 用 Milvus Lite（单文件 ./data/milvus.db，零运维，不用起 Docker）
# 上生产再换成 standalone 的 http:// 地址，代码不用改
MILVUS_URI=./data/milvus.db
# 双层索引：先筛文档，再找段落
MILVUS_COLLECTION_ITEM=kb_item_names
MILVUS_COLLECTION_CHUNK=kb_chunks
TOP_K_DENSE=20
TOP_K_SPARSE=20
# RRF 融合公式的 k，行业惯例值 60
RRF_K=60

# ---------------- MongoDB（元数据 / 解析结果 / 切片 / 任务 / 对话历史）----------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=zhanggui_zhiku

# ---------------- MinIO（原始文件与图片）----------------
# M0 阶段关掉，用本地目录（data/parsed）代替，不引额外服务
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zhiku
MINIO_SECURE=false

# ---------------- 文档切分 ----------------
# 这三个是待实测调参的初始值，不是定论。
# 改这几个值就可以做对比实验，不用改代码。
CHUNK_MAX_SIZE=1000
CHUNK_MIN_SIZE=200
CHUNK_OVERLAP_RATIO=0.15

# ---------------- 日志 ----------------
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
# 修正日志显示的调用位置（穿透 loguru 内部帧）；压测时可关掉省开销
LOG_FIX_POSITION=true
